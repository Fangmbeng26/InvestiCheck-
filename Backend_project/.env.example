# Copy this file to .env and fill in the values. Never commit .env.

# --- Required ---------------------------------------------------------------

# Port the API listens on. 4000 matches the frontend's default VITE_API_URL.
PORT=4000

# MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/investicheck

# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Optional (sensible defaults applied if omitted) ------------------------

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# How long an access token stays valid.
JWT_EXPIRES_IN=1h

# node env: development | test | production
NODE_ENV=development

# Per-probe timeout for outbound OSINT lookups, in milliseconds.
OSINT_TIMEOUT_MS=8000

# Overall budget for the whole OSINT pass, in milliseconds.
OSINT_TOTAL_BUDGET_MS=12000

# How long an OSINT result is reused before being re-fetched, in seconds.
OSINT_CACHE_TTL_SECONDS=86400

# Risk model used when the request does not name one: v1 (SRS-literal) or v2 (normalised).
DEFAULT_RISK_MODEL=v2

# Number of admin-reviewed withdrawal reports that corroborate the B3 indicator.
REPORT_CORROBORATION_THRESHOLD=3
